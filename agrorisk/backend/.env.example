# IBM watsonx
WATSONX_API_KEY=your_ibm_api_key_here
WATSONX_PROJECT_ID=your_project_id_here
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# Banco de dados
DATABASE_URL=postgresql+asyncpg://agrorisk:agrorisk@localhost:5432/agrorisk
REDIS_URL=redis://localhost:6379/0

# APIs públicas (gratuitas, sem chave obrigatória para uso básico)
RECEITAWS_BASE_URL=https://receitaws.com.br/v1
CNPJA_BASE_URL=https://api.cnpja.com
DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
PGFN_BASE_URL=https://www.regularize.pgfn.gov.br

# App
APP_ENV=development
LOG_LEVEL=INFO
MONITORING_ENABLED=true
